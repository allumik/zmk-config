#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAVR 1
#define MOUR 2
#define FUNL 3
#define NSL  4

/ {
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <165>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };
    lt_custom: layer_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <165>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&mo>, <&kp>;
    };
  };

  combos {
    compatible = "zmk,combos";
    combo_opar { timeout-ms = <160>; key-positions = <13 14>; bindings = <&kp LPAR>; };
    combo_cpar { timeout-ms = <160>; key-positions = <15 16>; bindings = <&kp RPAR>; };
    combo_obra { timeout-ms = <160>; key-positions = <23 24>; bindings = <&kp LBKT>; };
    combo_cbra { timeout-ms = <160>; key-positions = <25 26>; bindings = <&kp RBKT>; };
    combo_gt { timeout-ms = <160>; key-positions = <5 6>; bindings = <&kp GT>; };
    combo_lt { timeout-ms = <160>; key-positions = <3 4>; bindings = <&kp LT>; };
    combo_minus { timeout-ms = <160>; key-positions = <4 14>; bindings = <&kp MINUS>; };
    combo_equal { timeout-ms = <160>; key-positions = <5 15>; bindings = <&kp EQUAL>; };
    combo_super_l { timeout-ms = <160>; key-positions = <13 23>; bindings = <&kp LGUI>; };
    combo_super_r { timeout-ms = <160>; key-positions = <16 26>; bindings = <&kp LGUI>; };
    combo_lalgr_l { timeout-ms = <160>; key-positions = <14 24>; bindings = <&kp RALT>; };
    combo_lalgr_r { timeout-ms = <160>; key-positions = <15 25>; bindings = <&kp RALT>; };
    combo_lalt_l { timeout-ms = <160>; key-positions = <12 22>; bindings = <&kp LALT>; };
    combo_lalt_r { timeout-ms = <160>; key-positions = <17 27>; bindings = <&kp LALT>; };
    combo_tab { timeout-ms = <160>; key-positions = <0 1>; bindings = <&kp TAB>; };
    combo_del { timeout-ms = <160>; key-positions = <8 9>; bindings = <&kp DEL>; };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp Q       &kp W       &kp F      &kp P      &kp B           &kp J        &kp L        &kp U        &kp Y       &kp SQT
        &kp A       &kp R       &kp S      &kp T      &kp G           &kp M        &kp N        &kp E        &kp I       &kp O
        &hm LCTRL Z &hm LSHFT X &kp C      &kp D      &kp V           &kp K        &kp H        &kp COMMA    &hm LSHFT DOT &hm LCTRL FSLH
                                &lt_custom NAVR SPACE &lt_custom MOUR ESC  &lt_custom FUNL RET  &lt_custom NSL BSPC
      >;
    };

    nav_layer {
      bindings = <
        &none       &none       &none      &none      &none           &kp CAPS     &kp K_UNDO   &kp K_CUT    &kp K_COPY  &kp K_PASTE
        &none       &none       &none      &none      &none           &kp K_AGAIN  &kp LEFT     &kp DOWN     &kp UP      &kp RIGHT
        &kp LCTRL   &kp LSHFT   &kp LALT   &kp LGUI   &kp RALT        &kp INS      &kp HOME     &kp PGDN     &kp PGUP    &kp END
                                &none      &none                      &kp RET      &kp BSPC
      >;
    };

    mouse_layer {
      bindings = <
        &none       &none       &none      &none      &none           &none        &none          &mmv MOVE_UP   &none          &none
        &none       &none       &none      &none      &none           &none        &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none
        &kp LCTRL   &kp LSHFT   &kp LALT   &kp LGUI   &kp RALT        &mkp MB3     &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP   &msc SCRL_RIGHT
                                &none      &none                      &mkp MB1     &mkp MB2
      >;
    };

    media_layer {
      bindings = <
        &kp F12     &kp F7      &kp F8     &kp F9     &kp PSCRN       &none        &none        &kp C_PREV   &kp C_NEXT  &none
        &kp F11     &kp F4      &kp F5     &kp F6     &kp SLCK        &kp C_STOP   &kp C_PP     &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
        &kp F10     &kp F1      &kp F2     &kp F3     &kp PAUSE_BREAK &kp RALT     &kp LGUI     &kp LALT     &kp LSHFT   &kp LCTRL
                                &kp TAB    &kp ESC                    &none        &none
      >;
    };

    num_sym_layer {
      bindings = <
        &kp LBKT    &kp N7      &kp N8     &kp N9     &kp RBKT        &none        &none        &none        &kp RA(LBKT) &kp RA(RBKT)
        &kp SEMI    &kp N4      &kp N5     &kp N6     &kp EQUAL       &none        &none        &none        &kp RA(SEMI) &kp RA(SQT)
        &kp GRAVE   &kp N1      &kp N2     &kp N3     &kp BSLH        &kp RALT     &kp LGUI     &kp LALT     &kp LSHFT   &kp LCTRL
                                &kp N0     &kp MINUS                  &none        &none
      >;
    };
  };
};
